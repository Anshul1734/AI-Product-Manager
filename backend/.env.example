# ---------------------------------------------------------------------------
# AI Product Manager - environment configuration
# Copy to backend/.env and fill in GROQ_API_KEY. Everything else has a working
# default.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# --- LLM ------------------------------------------------------------------
# Model availability differs per Groq account. List what your key can reach:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#        https://api.groq.com/openai/v1/models | jq '.data[].id'
# Whatever you choose must support BOTH native tool calling and JSON mode --
# the agent loop depends on each.
GROQ_MODEL=openai/gpt-oss-120b
# Smaller sibling used for the quality review and for `depth=quick` runs.
GROQ_FAST_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# --- Agent behaviour ------------------------------------------------------
# Tool-calling rounds allowed per agent before it must answer.
MAX_TOOL_ITERATIONS=3
# Schema-repair retries when output fails validation.
MAX_REPAIR_ATTEMPTS=2
# Refinement passes over artifacts that fail review (depth=deep only).
MAX_REFINE_PASSES=1
# Artifacts scoring below this out of 10 get regenerated on depth=deep.
QUALITY_THRESHOLD=7.0

# --- Retrieval (RAG) ------------------------------------------------------
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MAX_CHUNKS_PER_DOC=2
RAG_MAX_CONTEXT_CHARS=6000

# Dense retrieval is optional. With no embedding key, retrieval runs BM25-only,
# which needs no external service. Set a key and rebuild the index with
# `python -m app.rag.ingest --with-vectors` to enable hybrid search.
#   auto   - use a provider if its key is present, else BM25-only
#   none   - force BM25-only
#   openai - text-embedding-3-small
#   jina   - jina-embeddings-v3
EMBEDDING_PROVIDER=auto
# OPENAI_API_KEY=sk-...
# JINA_API_KEY=jina_...
# EMBEDDING_MODEL=text-embedding-3-small

# --- Memory ---------------------------------------------------------------
# Recall over previously generated plans. On serverless this persists to /tmp,
# which is per-instance and lost on cold start.
MEMORY_ENABLED=true
MEMORY_MAX_ENTRIES_PER_THREAD=20
MEMORY_MAX_AGE_DAYS=30

# --- External MCP servers (optional) --------------------------------------
# Tools from these servers are offered to the ticket agent, letting it act on
# systems this app does not own. Requires `pip install -r requirements-dev.txt`.
# Skipped automatically on serverless, which cannot spawn stdio subprocesses.
# MCP_SERVERS=[{"name":"linear","command":"npx","args":["-y","@linear/mcp-server"],"env":{"LINEAR_API_KEY":"..."}}]
MCP_SERVERS=[]
MCP_TOOL_TIMEOUT=20

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text

# Comma-separated. Use your deployed frontend origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

venv/
.venv/
backend/.venv/
.env
*.env
# Anything with a suffix after .env (.env.local, .env.backup-*, ...).
# Without this, `*.env` misses them and a key-bearing file can be committed.
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example


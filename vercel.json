{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "backend/asgi.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/asgi.py" },
    { "src": "/docs(.*)", "dest": "/backend/asgi.py" },
    { "src": "/redoc(.*)", "dest": "/backend/asgi.py" },
    { "src": "/openapi.json", "dest": "/backend/asgi.py" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
